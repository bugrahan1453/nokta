# ============================================================
# Binance Futures Trading Bot - Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp .env olarak kaydedin ve değerleri doldurun
# ============================================================

# ---- BINANCE API ----
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
# Testnet kullanmak için: true, canlı için: false
BINANCE_TESTNET=false
# Testnet URL'leri (BINANCE_TESTNET=true ise kullanılır)
BINANCE_TESTNET_URL=https://testnet.binancefuture.com

# ---- CLAUDE AI API ----
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Kullanılacak Claude modeli
ANTHROPIC_MODEL=claude-opus-4-6

# ---- TELEGRAM ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Telegram bildirimlerini aktif et: true/false
TELEGRAM_ENABLED=true

# ---- WEB ARAYÜZÜ ----
# Web şifresi (giriş ekranı)
WEB_PASSWORD=change_this_password_123
# Flask gizli anahtarı (rastgele uzun bir string)
SECRET_KEY=change_this_secret_key_very_long_random_string
# Web sunucu portu
WEB_PORT=5000
# Web sunucu hostu (0.0.0.0 = tüm arayüzler)
WEB_HOST=0.0.0.0
# Debug modu: false (production'da kesinlikle false olmalı)
FLASK_DEBUG=false

# ---- BOT GENEL AYARLAR ----
# İşlem yapılacak pariteler (virgülle ayrılmış)
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
# Maksimum eş zamanlı açık pozisyon sayısı
MAX_CONCURRENT_POSITIONS=3
# Günlük maksimum kayıp limiti (USDT)
DAILY_MAX_LOSS=100.0
# Bot çalışma saatleri (24 saat formatı, boş bırakılırsa 7/24)
TRADING_START_HOUR=0
TRADING_END_HOUR=24
# Sinyal zaman dilimi (dakika): 5 veya 15
SIGNAL_TIMEFRAME=5
# Trend onay zaman dilimi (dakika)
TREND_TIMEFRAME=15

# ---- RİSK YÖNETİMİ ----
# Her işlem için kullanılacak kasa yüzdesi (varsayılan)
DEFAULT_POSITION_SIZE_PCT=2.0
# Varsayılan kaldıraç
DEFAULT_LEVERAGE=10
# Varsayılan stop-loss yüzdesi
DEFAULT_STOP_LOSS_PCT=1.5
# Varsayılan take-profit yüzdesi
DEFAULT_TAKE_PROFIT_PCT=3.0
# Trailing stop aktifleşme için minimum PNL yüzdesi
DEFAULT_TRAILING_ACTIVATION_PCT=1.0
# Trailing stop geri çekilme yüzdesi
DEFAULT_TRAILING_CALLBACK_PCT=0.5
# Maksimum funding rate uyarı eşiği (%)
MAX_FUNDING_RATE_PCT=0.1

# ---- PARİTE ÖZEL AYARLAR (opsiyonel, yoksa varsayılan kullanılır) ----
# Format: SYMBOL_LEVERAGE, SYMBOL_POSITION_SIZE_PCT, vb.
BTCUSDT_LEVERAGE=10
BTCUSDT_POSITION_SIZE_PCT=2.0
BTCUSDT_STOP_LOSS_PCT=1.5
BTCUSDT_TAKE_PROFIT_PCT=3.0
BTCUSDT_TRAILING_ACTIVATION_PCT=1.0

ETHUSDT_LEVERAGE=15
ETHUSDT_POSITION_SIZE_PCT=1.5
ETHUSDT_STOP_LOSS_PCT=2.0
ETHUSDT_TAKE_PROFIT_PCT=4.0
ETHUSDT_TRAILING_ACTIVATION_PCT=1.5

BNBUSDT_LEVERAGE=10
BNBUSDT_POSITION_SIZE_PCT=1.0
BNBUSDT_STOP_LOSS_PCT=2.0
BNBUSDT_TAKE_PROFIT_PCT=4.0
BNBUSDT_TRAILING_ACTIVATION_PCT=1.5

# ---- VERİTABANI ----
# SQLite veritabanı dosya yolu
DATABASE_PATH=trading_bot.db

# ---- LOG ----
# Log seviyesi: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log dosyası yolu
LOG_FILE=logs/trading_bot.log
# Maksimum log dosyası boyutu (MB)
LOG_MAX_SIZE_MB=50
# Saklanacak log yedek sayısı
LOG_BACKUP_COUNT=5

# ---- WATCHDOG ----
# Bağlantı kontrol aralığı (saniye)
WATCHDOG_INTERVAL=30
# Maksimum yeniden bağlanma denemesi
MAX_RECONNECT_ATTEMPTS=5
# Yeniden bağlanma bekleme süresi (saniye)
RECONNECT_DELAY=5

# ---- AI ZAMANLAYICI ----
# Sabah optimizasyon raporu saati (saat:dakika formatı)
AI_MORNING_REPORT_TIME=08:00
# Ekonomik takvim kontrol aralığı (dakika)
CALENDAR_CHECK_INTERVAL=60
# Haber öncesi/sonrası beklenecek süre (dakika)
NEWS_BLACKOUT_MINUTES=30

# ==============================================================
# GELİŞMİŞ ANALİZ MODÜLLERİ (OPSİYONEL)
# ==============================================================

# ---- KATMAN 4 (Gelişmiş İndikatörler) ----
# Katman 4'ü aktif et (BB, StochRSI, VWAP, Pattern, Divergence)
LAYER4_ENABLED=true
# Strict mod: Katman 4 negatif sinyal verirse işlem açılmaz
LAYER4_STRICT=false

# ---- ATR TABANLI DİNAMİK SL/TP ----
# Sabit yüzde yerine ATR kullan
ATR_SL_ENABLED=true
# SL = ATR × çarpan (2.0 önerilir)
ATR_SL_MULTIPLIER=2.0
# TP = ATR × çarpan (3.0 önerilir)
ATR_TP_MULTIPLIER=3.0
# Chandelier Exit trailing stop periyodu
CHANDELIER_PERIOD=22
# Chandelier Exit çarpanı
CHANDELIER_MULTIPLIER=3.0

# ---- KELLY KRİTERİ POZİSYON BOYUTLANDIRMA ----
# İşlem geçmişinden optimal boyut hesapla (en az 10 işlem gerekli)
KELLY_ENABLED=false
# Fraksiyonel Kelly (0.25 = güvenli, 0.5 = agresif)
KELLY_FRACTION=0.25
# Minimum geçmiş işlem sayısı
KELLY_MIN_TRADES=10

# ---- ORDER BOOK ANALİZİ ----
ORDERBOOK_ENABLED=true
ORDERBOOK_DEPTH=20

# ---- OPEN INTEREST ANALİZİ ----
OI_ENABLED=true

# ---- FEAR & GREED INDEX (Ücretsiz - alternative.me) ----
FEAR_GREED_ENABLED=true

# ---- ON-CHAIN ANALİZ (Glassnode) - OPSİYONEL ----
# Ücretsiz tier için kayıt: https://glassnode.com
# Boş bırakılırsa devre dışı
GLASSNODE_API_KEY=

# ---- ON-CHAIN ANALİZ (CryptoQuant) - OPSİYONEL ----
# API anahtarı: https://cryptoquant.com
# Boş bırakılırsa devre dışı
CRYPTOQUANT_API_KEY=

# ---- WHALE ANALİZİ (Binance Aggr. Trades - Ücretsiz) ----
WHALE_ENABLED=true
# Balina olarak sayılacak minimum işlem hacmi (USDT)
WHALE_MIN_USDT=500000

# ---- KATMAN 5 (ML + Sentiment + Advanced Ensemble) ----
LAYER5_ENABLED=true

# ---- MAKİNE ÖĞRENMESİ - OPSİYONEL ----
# pip install xgboost lightgbm torch scikit-learn
ML_ENABLED=false

# ---- DUYGU ANALİZİ - OPSİYONEL ----
SENTIMENT_ENABLED=false

# Twitter/X API v2 Bearer Token (opsiyonel)
# https://developer.twitter.com
TWITTER_BEARER_TOKEN=

# Reddit API (opsiyonel)
# https://www.reddit.com/prefs/apps → "script" uygulaması oluştur
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# FinBERT - Finansal duygu analizi (opsiyonel)
# pip install transformers torch  →  ilk çalıştırmada ~400MB model indirir
FINBERT_ENABLED=false

# ---- ENSEMBLE AYARLARI ----
# İşlem için minimum güven skoru (0-100)
ENSEMBLE_MIN_CONFIDENCE=40
# Sinyal yönü için minimum skor eşiği (-1 ile +1 arası)
ENSEMBLE_DIRECTION_THRESHOLD=0.15
# Bayesian ağırlık güncellemesi (geçmiş başarıya göre modül ağırlıklarını ayarlar)
ENSEMBLE_USE_BAYESIAN=true
